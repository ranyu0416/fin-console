# 财务管理台环境配置 —— 放到 /etc/fin-console.env，权限设为 600
# 改完执行：sudo systemctl restart fin-console

# 监听地址。前面挂了 nginx/caddy 就保持 127.0.0.1；
# 想让局域网直连改成 0.0.0.0（此时务必配好防火墙）
FIN_HOST=127.0.0.1
FIN_PORT=8787

# 账套数据与备份目录（systemd 单元里已授予写权限）
# 首次部署：sudo mkdir -p /var/lib/fin-console && sudo chown finconsole:finconsole /var/lib/fin-console
FIN_DATA_DIR=/var/lib/fin-console

# 打印表头「编制单位」的默认值，例如 XX集团有限公司
FIN_ORG_NAME=

# 首次启动创建的管理员账号；口令留空则自动生成并打印到 journalctl
# 首次登录后会被强制改密，之后这里可以清空
FIN_ADMIN_USER=admin
FIN_ADMIN_PASSWORD=

# 通过 HTTPS 访问时设为 1（Cookie 带 Secure）
FIN_COOKIE_SECURE=0
# 在反向代理之后设为 1，日志才记录真实来访 IP
FIN_TRUST_PROXY=0

# 会话有效期（小时）
FIN_SESSION_HOURS=12

# 登录失败锁定
FIN_LOGIN_MAX_ATTEMPTS=8
FIN_LOGIN_WINDOW_MINUTES=15

# 自动热备：间隔小时数（0 关闭）与保留份数
FIN_BACKUP_INTERVAL_HOURS=24
FIN_BACKUP_KEEP=30

TZ=Asia/Shanghai
